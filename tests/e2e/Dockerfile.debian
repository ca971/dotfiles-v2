# ═══════════════════════════════════════════════════════════════════════════════
# @file tests/e2e/Dockerfile.debian
# @description E2E test environment — Debian/Ubuntu
# @since 1.0.0
# @version 1.0.0
# ═══════════════════════════════════════════════════════════════════════════════

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV DOTFILES_DIR=/home/testuser/.dotfiles
ENV HOME=/home/testuser
ENV LOG_COLOR=0

# Install base dependencies
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        bash \
        curl \
        git \
        jq \
        ca-certificates \
        sudo \
        zsh \
        fish \
        bats \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install taplo
RUN curl -fsSL https://github.com/tamasfe/taplo/releases/latest/download/taplo-full-linux-x86_64.gz \
    | gunzip > /usr/local/bin/taplo && chmod +x /usr/local/bin/taplo

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# Create test user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Copy dotfiles
COPY --chown=testuser:testuser . ${DOTFILES_DIR}

# Switch to test user
USER testuser
WORKDIR ${DOTFILES_DIR}

# Install uv for testuser
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/home/testuser/.local/bin:${PATH}"

# Setup generators and generate configs
RUN cd generators && uv sync && uv run python -m src.cli generate --all

# Initialize state
RUN mkdir -p local && \
    echo '{"version":1,"tools":{},"nix_envs":{},"theme":"minimal"}' > local/state.json && \
    chmod 700 local/secrets local/ssh local/ssh/keys

CMD ["bash"]
